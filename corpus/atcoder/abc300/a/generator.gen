generate {
    N in 1..=300
    A in 1..=1000
    B in 1..=1000
    AnswerIndex in 1..=N
    Distractors[N]
    C[N]
    Distractors in unique(1..=2000) except(A+B)
    for i in 1..=N {
        if i == AnswerIndex {
            C[i] in (A+B)..=(A+B)
        } else {
            C[i] in Distractors[i]..=Distractors[i]
        }
    }
}

input {
    N A B
    C
}
