generate {
    N in 1..=200000
    M in 1..=200000
    H in 1..=200000
    K in 1..=200000
    S : string[N]
    X[M]
    Y[M]
    X in unique(-200000..=200000)
    for i in 1..=N {
        S[i] in "RLUD"
    }
    for i in 1..=M {
        Y[i] in -200000..=200000
    }
}

input {
    N M H K
    S
    for i in 1..=M {
        X[i] Y[i]
    }
}
