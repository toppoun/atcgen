generate {
    N in 2..=65
    Q in 1..=(N-1)
    Kind[Q]
    U[Q]
    V[Q]
    for i in 1..=Q {
        Kind[i] in 1..=3
        if Kind[i] == 1 {
            U[i] in 1..=i
            V[i] in (i+1)..=(i+1)
        } else {
            V[i] in 1..=N
        }
    }
}

input {
    N Q
    for i in 1..=Q {
        if Kind[i] == 1 {
            Kind[i] U[i] V[i]
        } else {
            Kind[i] V[i]
        }
    }
}
