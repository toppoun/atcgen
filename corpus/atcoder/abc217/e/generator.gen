generate {
    Q in 1..=200000
    Pick[Q]
    Kind[Q]
    X[Q]
    Size[Q+1]
    Size[1] in 0..=0
    for i in 1..=Q {
        if Size[i] == 0 {
            Pick[i] in 1..=2
            Kind[i] in (2*Pick[i]-1)..=(2*Pick[i]-1)
        } else {
            Pick[i] in 1..=3
            Kind[i] in Pick[i]..=Pick[i]
        }
        if Kind[i] == 1 {
            X[i] in 0..=1000000000
            Size[i+1] in (Size[i]+1)..=(Size[i]+1)
        } else {
            if Kind[i] == 2 {
                Size[i+1] in (Size[i]-1)..=(Size[i]-1)
            } else {
                Size[i+1] in Size[i]..=Size[i]
            }
        }
    }
}

input {
    Q
    for i in 1..=Q {
        if Kind[i] == 1 {
            Kind[i] X[i]
        } else {
            Kind[i]
        }
    }
}
