generate {
    N in 1..=6
    A[N*(N+1)/2]
    for i in 1..=N*(N+1)/2 {
        A[i] in 1..=N
    }
}

input {
    N
    A[1]
    for i in 1..=(N+4)/6 {
        A[2] A[3]
    }
    for i in 1..=(N+3)/6 {
        A[4] A[5] A[6]
    }
    for i in 1..=(N+2)/6 {
        A[7] A[8] A[9] A[10]
    }
    for i in 1..=(N+1)/6 {
        A[11] A[12] A[13] A[14] A[15]
    }
    for i in 1..=N/6 {
        A[16] A[17] A[18] A[19] A[20] A[21]
    }
}
